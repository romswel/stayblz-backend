# Copy to .env and use a development Supabase project. Never commit actual values.
PORT=4000
# Comma-separated exact frontend origins; no paths or trailing slashes.
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Replace locally with your project's privileged key.
SUPABASE_SECRET_KEY=replace-with-your-server-only-key
