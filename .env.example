# Copy to .env and use a development Supabase project. Never commit actual values.
PORT=4000
# Comma-separated exact frontend origins; no paths or trailing slashes.
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Replace locally with your project's privileged key.
SUPABASE_SECRET_KEY=replace-with-your-server-only-key
# Optional publishable key for server-side Auth calls. Never expose the secret key.
SUPABASE_PUBLISHABLE_KEY=
AUTH_SITE_URL=http://localhost:5173
# Optional. "true" makes 2-step login mandatory before admins can open administration.
REQUIRE_STAFF_MFA=false
# Optional. Requests per minute per client across the whole API (default 1200; 0 = off).
API_RATE_LIMIT_PER_MINUTE=1200
# Local development only. Ignored on Render or NODE_ENV=production.
ENABLE_PUBLIC_DEMO=false
DEMO_ADMIN_PASSWORD=
