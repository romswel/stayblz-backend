# Stayblz API settings. Copy to .env for local development. Placeholders only: never commit real values.
# Production values are set in Render → Environment (see docs/production-config.md).

# ── Required ─────────────────────────────────────────────────────────────────────────────
# Local: development. Render: production (Render also sets RENDER=true, which the app treats as production).
NODE_ENV=development
# Render sets PORT itself; locally the API listens on 4000.
PORT=4000
# Exact browser origins allowed to call the API with cookies. Comma-separated, no paths.
#   Local:      http://localhost:5173
#   Production: https://stayblz-app.com
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only (Supabase → Project Settings → API keys → secret key). Never in the frontend.
SUPABASE_SECRET_KEY=replace-with-your-server-only-key

# ── Recommended ──────────────────────────────────────────────────────────────────────────
# The site email links point to. Defaults to the first FRONTEND_URL origin.
#   Production: https://stayblz-app.com
AUTH_SITE_URL=http://localhost:5173
# Public (publishable/anon) key for sign-in, sign-up and code checks. Falls back to the secret key.
SUPABASE_PUBLISHABLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────
# "true" makes 2-step login mandatory before admins can open administration.
REQUIRE_STAFF_MFA=false
# Requests per minute per network address across the whole API (default 1200; 0 = off).
API_RATE_LIMIT_PER_MINUTE=1200

# ── Local development only (ignored on Render or when NODE_ENV=production) ────────────────
# Offline demo login (username "superadmin"). Needs both values; leave off unless you need it.
ENABLE_PUBLIC_DEMO=false
DEMO_ADMIN_PASSWORD=

# ── Release tooling only (not read by the API) ───────────────────────────────────────────
# Postgres connection (Supabase session pooler) for applying approved release SQL.
DATABASE_URL=
