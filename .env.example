# Stayblz API settings. Copy to .env for local development. Placeholders only: never commit real values.
# Production values are set in Render → Environment (see docs/production-config.md).

# ── Required ─────────────────────────────────────────────────────────────────────────────
# Local: development. Render: production (Render also sets RENDER=true, which the app treats as production).
NODE_ENV=development
# Render sets PORT itself; locally the API listens on 4000.
PORT=4000
# Exact browser origins allowed to call the API with cookies. Comma-separated, no paths.
#   Local:      http://localhost:5173
#   Production: https://stayblz-app.com
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only (Supabase → Project Settings → API keys → secret key). Never in the frontend.
SUPABASE_SECRET_KEY=replace-with-your-server-only-key

# ── Recommended ──────────────────────────────────────────────────────────────────────────
# The site email links point to. Defaults to the first FRONTEND_URL origin.
#   Production: https://stayblz-app.com
AUTH_SITE_URL=http://localhost:5173
# Public (publishable/anon) key for sign-in, sign-up and code checks. Falls back to the secret key.
SUPABASE_PUBLISHABLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────
# "true" makes 2-step login mandatory before admins can open administration.
REQUIRE_STAFF_MFA=false
# Requests per minute per network address across the whole API (default 1200; 0 = off).
API_RATE_LIMIT_PER_MINUTE=1200

# STAYBLZ TV (all optional; off air when unset). See src/lib/tv.ts.
#   TV_ON_AIR       "true" while broadcasting
#   TV_STREAM_URL   https HLS playlist (.m3u8). Its host must also be allowed in the frontend's CSP.
#   TV_TITLE        What is on / on next (max 120 characters)
#   TV_NEXT_AT      Next broadcast start, ISO date-time, e.g. 2026-11-20T18:30:00Z
#   TV_EMBED_URL    Demo only, used when TV_STREAM_URL is empty: a YouTube video link (optional ?t=seconds)
#                   or a channel's live link, e.g. https://www.youtube.com/channel/UCzU39Vjjyv2_SXipboFPAsQ/live
#                   (Los Alamitos Race Course, live Sat/Sun nights). Needs youtube frame-src in the frontend CSP.
#   TV_YOUTUBE_CHANNELS  Extra YouTube channel ids (comma-separated UC…) on top of the built-in track
#                   channels in src/lib/tvChannels.ts. Their videos appear under Replays (public RSS feed).
#   TV_YOUTUBE_DEFAULTS  "off" drops the built-in track channels (tests use this).
#   YOUTUBE_API_KEY  YouTube Data API v3 key (Google Cloud → Credentials; restrict it to that API). Finds
#                   which tracks are live / upcoming and the latest broadcast. Empty = Live only follows TV_ON_AIR.
TV_ON_AIR=false
TV_STREAM_URL=
TV_TITLE=
TV_NEXT_AT=
TV_EMBED_URL=
TV_YOUTUBE_CHANNELS=
TV_YOUTUBE_DEFAULTS=
YOUTUBE_API_KEY=

# Cloudflare R2 file storage (optional; off when unset). Shared with Suprah: same Cloudflare account
# and buckets. Stayblz only ever touches keys under stayblz/ (fixed in src/lib/r2Storage.ts).
# Get the values from the Suprah backend's settings. Check with: npm run r2:check  (see docs/r2-storage.md)
#   R2_ENDPOINT        https://<account-id>.r2.cloudflarestorage.com   (no bucket name in it)
#   R2_BUCKET_PRIVATE  files the API streams after its own permission check
#   R2_BUCKET_PUBLIC   files anyone may open by link
#   R2_PUBLIC_URL      the public bucket's web address (custom domain or r2.dev); only for public links
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC=
R2_PUBLIC_URL=

# ── Local development only (ignored on Render or when NODE_ENV=production) ────────────────
# Offline demo login (username "superadmin"). Needs both values; leave off unless you need it.
ENABLE_PUBLIC_DEMO=false
DEMO_ADMIN_PASSWORD=

# ── Release tooling only (not read by the API) ───────────────────────────────────────────
# Postgres connection (Supabase session pooler) for applying approved release SQL.
DATABASE_URL=

# ── Racing data (docs/racing-data-feed.md) ──────────────────────────────────────────────
# The Racing API login (the "Equibase API" login the boss gave is this one). With it set, the API pulls racecards,
# results and earlier starts automatically while awake, and admins can pull from Publishing → Data feed.
RACING_API_USERNAME=
RACING_API_PASSWORD=
# Optional: only these provider regions (e.g. gb,ire,fr,hk). Empty = every region the plan includes.
RACING_API_REGIONS=
# Optional: "off" stops the automatic pulls (manual pulls still work).
RACING_FEED_AUTO=
# Other sources that may be published: comma-separated (e.g. "equibase"), or "yes" for all. The Racing API is
# allowed by its terms; anything else (the collected Equibase files) stays a draft until listed here.
RACING_FEED_LICENSED=
