{
  "name": "stayblz-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run build && node --test tests/*.test.cjs",
    "racing:check": "npm run build && node scripts/racing-feed-check.cjs",
    "racing:pull": "npm run build && node scripts/racing-pull.cjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "post-update": "npm run build && node scripts/post-update.cjs",
    "r2:check": "npm run build && node scripts/r2-check.cjs",
    "push:keys": "node scripts/push-keys.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
